{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reinersystems",
  "compatibility_date": "2025-12-08",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "reiner.systems",
      "custom_domain": true,
    },
    {
      "pattern": "www.reiner.systems",
      "custom_domain": true,
    },
  ],
}
