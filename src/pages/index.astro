---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { format } from "date-fns";

const posts = await getCollection("post");
---

<Layout title="Jeff Reiner, Product Engineer" path="/">
  <main class="max-w-[80ch]">
    <section>
      <div class="p-5">
        <h3>Writing</h3>

        <ul>
          {
            posts.map((post) => (
              <li>
                <div class="flex items-baseline gap-[1ch]">
                  <time
                    class="whitespace-nowrap uppercase"
                    datetime={post.data.date.toISOString()}
                  >
                    {`[${format(post.data.date, "MMM.dd.yyyy")}]`}
                  </time>

                  <span class="hidden sm:inline text-overflow-clip min-w-2 whitespace-nowrap flex-1 overflow-hidden">
                    ..............................................................
                  </span>

                  <a
                    href={post.id}
                    class="sm:whitespace-nowrap sm:text-right underline"
                  >
                    {post.data.title}
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</Layout>
