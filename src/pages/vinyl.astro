---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const collection = await getCollection("vinyl");

const records = collection.sort(
  (a, b) => +new Date(b.data.date_added) - +new Date(a.data.date_added),
);
---

<Layout title="Vinyl" path="/vinyl">
  <main class="max-w-360">
    <section>
      <div class="p-5">
        <h1>Vinyl</h1>

        <ul data-vinyl-list class="relative flex flex-col w-full">
          {
            records.map((record) => {
              const q = encodeURIComponent(
                `${record.data.artist} ${record.data.title} ${record.data.year}`,
              );

              return (
                <li
                  class="flex items-baseline gap-[1ch]"
                  data-cover={record.data.file_name}
                  data-artist={record.data.artist}
                  data-title={record.data.title}
                  data-year={record.data.year}
                >
                  {record.data.video_id && (
                    <lite-youtube
                      videoid={record.data.video_id}
                      videotitle={record.data.title}
                      posterquality="maxresdefault"
                    />
                  )}

                  <a
                    target="_blank"
                    rel="noopener nofollow"
                    href={`https://www.youtube.com/results?search_query=${q}`}
                    class="text-left sm:whitespace-nowrap"
                  >
                    {record.data.artist}
                    <span class="mx-[0.5ch]">—</span>
                    <span>{record.data.title}</span>
                  </a>

                  <span class="hidden sm:inline overflow-hidden flex-1 min-w-2 select-none">
                    <span class="whitespace-nowrap">{".".repeat(200)}</span>
                  </span>

                  <span class="sm:whitespace-nowrap sm:text-right tabular-nums select-none">
                    {`[${record.data.year}]`}
                  </span>

                  <a
                    target="_blank"
                    rel="noopener nofollow"
                    href={`https://www.discogs.com/release/${record.data.resource_id}`}
                    class="select-none sm:whitespace-nowrap sm:text-right"
                  >
                    {`↗`}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>
  </main>

  <div
    data-vinyl-stack
    class="fixed inset-0 items-center justify-center pointer-events-none z-40 hidden lg:flex"
    style="display:none"
  >
    <div class="relative" style="width:320px;height:320px"></div>
  </div>

  <style>
    lite-youtube {
      width: 160px;
      --lite-youtube-aspect-ratio: 1 / 1;
    }

    lite-youtube::part(playButton) {
      filter: grayscale(1);
      transition: filter 0.1s cubic-bezier(0, 0, 0.2, 1);
    }

    lite-youtube:hover::part(playButton) {
      filter: none;
    }
  </style>

  <script>
    import "../lite-youtube";
    import "../vinyl-stack";
  </script>
</Layout>
