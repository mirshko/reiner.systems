---
import "@fontsource-variable/inter";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../lib/cv/app/globals.css";
import Profile from "../lib/cv/app/Profile";
import cv from "../lib/cv/profileData.json";

const title = cv.general.displayName;
const description = cv.general.byline || "";
---

<BaseLayout path="/cv" title={title} description={description}>
  <div class="page">
    <Profile cv={cv} client:load />
  </div>
</BaseLayout>

<style>
  .page {
    padding: 0 24px;
  }
</style>
