---
import type { Metadata } from "../schemas/metadata";

export type Props = {
  url: string;
  metadata: Metadata["data"] | null;
};

const { url, metadata } = Astro.props;

const { hostname: domainOnly } = new URL(url);
---

{
  !metadata ? (
    <a href={url} target="_blank" rel="nofollow">
      {url}
    </a>
  ) : (
    <a
      href={url}
      target="_blank"
      rel="nofollow"
      title={url}
      class="grid grid-cols-[1fr_2fr] items-center my-5"
    >
      {metadata.image && (
        <img
          src={metadata.image}
          alt=""
          width={80}
          class="object-cover w-full aspect-1200/630 m-0!"
          loading="lazy"
        />
      )}

      <span class="pl-5 only:pl-0 flex flex-col gap-2 only:col-span-full">
        <span class="leading-tight font-bold">{metadata.title}</span>

        <span class="text-sm leading-tight opacity-60">
          {metadata.description}
        </span>

        <span class="text-sm leading-none opacity-40">{domainOnly}</span>
      </span>
    </a>
  )
}
