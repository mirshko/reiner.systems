<button data-email-button class="text-left group relative outline-hidden">
  <span
    class="group-hover:bg-ibm-foreground group-hover:text-ibm-background group-focus-visible:bg-ibm-foreground group-focus-visible:text-ibm-background"
  >
    email@reiner.systems
  </span>
  <span class="hidden group-data-copied:inline">copied</span>
</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-email-button]",
  )) {
    button.addEventListener("click", () => {
      window.navigator.clipboard.writeText("email@reiner.systems");

      button.dataset.copied = "true";
      setTimeout(() => delete button.dataset.copied, 1_000);
    });
  }
</script>
