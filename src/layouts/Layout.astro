---
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  path: `/${string}`;
}

const { ...rest } = Astro.props;
---

<BaseLayout {...rest}>
  <Header />

  <slot />

  <footer class="p-5 max-w-[80ch]">
    <div class="flex items-baseline gap-[1ch]">
      <span class="whitespace-nowrap text-right">
        {`[${new Date().getFullYear()}]`}
      </span>

      <span
        class="inline text-overflow-clip min-w-2 whitespace-nowrap flex-1 overflow-hidden"
      >
        .......................................................
      </span>

      <p class="uppercase whitespace-nowrap">reiner.systems</p>
    </div>
  </footer>
</BaseLayout>
